#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// WiFi credentials - Copy this file to Credentials.h and add your credentials
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Laravel API Configuration
// Set this to your Laravel backend URL (local development or production)
// Examples:
//   - Local with Valet: "http://thermostat.test"
//   - Local with IP:    "http://192.168.1.100"
//   - Production:       "https://yourserver.com"
#define API_URL "http://thermostat.test"
#define API_KEY "your-device-api-key"

// REQUIRED: password for over-the-air (WiFi) firmware uploads. upload.sh
// reads it from here. The build fails without it. Use a long random value,
// e.g. the output of: openssl rand -hex 16
#define OTA_PASSWORD ""

#endif // CREDENTIALS_H
